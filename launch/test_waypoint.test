<launch>
    <arg name="robot_type" />  <!-- dog/drone -->
    <include file="$(find gazebo_sim)/launch/iris_with_roscam2.launch">
        <arg name="gui" value="true" />
        <arg name="rviz" value="false" />
        <arg name="robot_type" value="$(arg robot_type)" />
        <arg name="output" value="log" />
    </include>
    <test pkg="mavproxy_ros" type="test_waypoint.py" test-name="test_waypoint" time-limit="1000000">
        <param name="robot_type" value="$(arg robot_type)" />
    </test>

    <include file="$(find gazebo_sim)/launch/apm.launch">
        <arg name="fcu_url" value="tcp://:5760@" />
        <arg name="respawn_mavros" value="true" />
    </include>
    <include file="$(find mavproxy_ros)/launch/onclick_run_$(arg robot_type)_sim.launch">
        <arg name="respawn" value="true" />
    </include>
</launch>