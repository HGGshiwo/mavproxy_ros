<launch>
    <arg name="odom_topic" default="/mavros/local_position/odom" />
    <arg name="drone_id" value="0"/>
    <arg name="robot_type" value="drone"/>  <!-- dog/drone -->
    <arg name="gui" default="true"/>

    <include file="$(find gazebo_sim)/launch/iris_with_roscam2.launch">
        <arg name="gui" value="$(arg gui)" />
        <arg name="rviz" value="false" />
        <arg name="robot_type" value="drone" />
        <arg name="output" value="log" />
    </include>
    <test pkg="mavproxy_ros" type="test_planner.py" test-name="test_planner" time-limit="600">
        <param name="robot_type" value="$(arg robot_type)" />
    </test>
    <include file="$(find gazebo_sim)/launch/apm.launch">
        <arg name="fcu_url" value="tcp://:5760@" />
        <arg name="respawn_mavros" value="true" />
    </include>
    <include file="$(find mavproxy_ros)/launch/onclick_run_drone_sim.launch">
        <arg name="respawn" value="true" />
    </include>
    <include file="$(find gazebo_sim)/launch/advanced_param_exp.xml">
        <arg name="use_distinctive_trajs" value="true" />
        <arg name="map_size_x_" value="40"/>
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_y_" value="40"/>
        <arg name="map_size_z_" value="3"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="10" />
        <!-- camera pose: transform of camera frame in the world frame -->
        <!-- depth topic: depth image, 640x480 by default -->
        <!-- don't set cloud_topic if you already set these ones! -->
        <arg name="camera_pose_topic" value="/camera_pose_in_map"/>
        <arg name="depth_topic" value="/roscam/front_cam/depth/image_raw"/>

        <!-- topic of point cloud measurement, such as from LIDAR  -->
        <!-- don't set camera pose and depth, if you already set this one! -->
        <arg name="cloud_topic" value="/points"/>

        <!-- intrinsic params of the depth camera -->
        <arg name="cx" value="319.5"/>
        <arg name="cy" value="239.5"/>
        <arg name="fx" value="205.5"/>
        <arg name="fy" value="207.0"/>

        <!-- maximum velocity and acceleration the drone will reach -->
        <arg name="max_vel" value="5.0" />
        <arg name="max_acc" value="3.0" />

        <!--always set to 1.5 times grater than sensing horizen-->
        <arg name="planning_horizon" value="7.5" /> 

        <!-- 1: use 2D Nav Goal to select goal  -->
        <!-- 2: use global waypoints below  -->
        <arg name="flight_type" value="1" />
        <arg name="point_num" value="4" />
        <arg name="point0_x" value="15" />
        <arg name="point0_y" value="0" />
        <arg name="point0_z" value="1" />
        <arg name="point1_x" value="-15.0" />
        <arg name="point1_y" value="0.0" />
        <arg name="point1_z" value="1.0" />
        <arg name="point2_x" value="15.0" />
        <arg name="point2_y" value="0.0" />
        <arg name="point2_z" value="1.0" />
        <arg name="point3_x" value="-15.0" />
        <arg name="point3_y" value="0.0" />
        <arg name="point3_z" value="1.0" />
        <arg name="point4_x" value="15.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="1.0" />
    </include>
    <!-- trajectory server -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <!-- <remap from="position_cmd" to="/setpoints_cmd"/> -->
        <!-- <remap from="planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/> -->
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <remap from="position_cmd" to="planning/pos_cmd"/>
    </node>
</launch>